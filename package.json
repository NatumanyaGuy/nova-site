		"postcss": "^8.5.15",
		"postcss-load-config": "^4.0.2",
		"prettier": "^2.8.8",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.2.20",
		"svelte-check": "^3.8.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^4.5.14"
	},
	"type": "module",
	"dependencies": {
		"@emailjs/browser": "^3.12.1",
		"daisyui": "^3.9.4",
